{
  "name": "choosr",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npm run android:dev",
    "android:dev": "npm run env:generate:dev && react-native run-android --mode devDebug",
    "android:uat": "npm run env:generate:uat && react-native run-android --mode uatDebug",
    "android:prod": "npm run env:generate:prod && react-native run-android --mode prodDebug",
    "env:generate": "node scripts/generate-env.mjs",
    "env:generate:dev": "node scripts/generate-env.mjs --environment=dev",
    "env:generate:uat": "node scripts/generate-env.mjs --environment=uat",
    "env:generate:prod": "node scripts/generate-env.mjs --environment=prod",
    "env:generate:test": "node scripts/generate-env.mjs --allow-placeholder",
    "env:verify": "node scripts/verify-environments.mjs",
    "secrets:verify": "node scripts/verify-no-committed-secrets.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{js,json,md}\" \"docs/**/*.md\" \".github/workflows/*.yml\"",
    "ios": "npm run ios:dev",
    "ios:dev": "npm run env:generate:dev && react-native run-ios --scheme Choosr-Dev",
    "ios:uat": "npm run env:generate:uat && react-native run-ios --scheme Choosr-UAT",
    "ios:prod": "npm run env:generate:prod && react-native run-ios --scheme Choosr-Prod",
    "lint": "eslint .",
    "prelint": "npm run env:generate:test",
    "prestart": "npm run env:generate",
    "pretest": "npm run env:generate:test",
    "pretypecheck": "npm run env:generate:test",
    "start": "react-native start",
    "supabase:lint": "supabase db lint --local --schema public --level error --fail-on error",
    "supabase:reset": "supabase db reset --local",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db --local",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-navigation/native": "^7.3.10",
    "@react-navigation/native-stack": "^7.18.2",
    "@supabase/supabase-js": "^2.110.7",
    "base64-arraybuffer": "^1.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^4.5.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "^0.11.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "googleapis": "^173.0.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "supabase": "^2.109.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
